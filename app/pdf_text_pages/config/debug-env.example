# Optional source-debug path; not required for installed-package verification.
# Copy to .env locally. Do not paste REMOTE_INSTALL_KEY into chat or logs.
# Real .env is excluded from Git and .difypkg; the agent does not read it.
INSTALL_METHOD=remote
# Use the reachable host:port from Dify Plugins > Debug, not the HTTP UI port.
REMOTE_INSTALL_URL=
REMOTE_INSTALL_KEY=
# Optional administrator-only budgets; defaults are defined in pdf_core/config.py.
# PDF_TEXT_PAGES_LIMITS={"max_files":5,"input_file_bytes":10485760,"input_total_bytes":26214400,"pages_per_file":20,"pages_total":30,"default_dpi":150,"max_dpi":200,"max_width":5000,"max_height":5000,"max_pixels":16000000,"output_file_bytes":8388608,"output_total_bytes":41943040,"text_chars":1000000,"fetch_seconds":20,"process_seconds":60,"request_seconds":100,"memory_bytes":1073741824,"concurrency":1}
# No provider credentials or allowed_sources JSON are used in 0.1.1.
# Real PDF fetching checks existing FILES_URL / INTERNAL_FILES_URL settings
# (presence-aware CONSOLE_API_URL / SERVER_CONSOLE_API_URL aliases).
# Do not derive trusted settings from input URLs or add guessed defaults.
# Missing settings are a node error; the deployment owner checks existing inheritance.
# No OpenAI API key is required by this plugin.
